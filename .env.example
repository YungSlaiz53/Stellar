# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# FARMFUND STELLAR EMBEDDED WALLET & SOROBAN ESCROW CONFIGURATION
# ============================================================================

# STELLAR_NETWORK: Target Stellar network ("TESTNET" or "PUBLIC").
# Defaults to TESTNET for non-commercial agricultural testing.
STELLAR_NETWORK="TESTNET"

# STELLAR_HORIZON_URL: Official Stellar Horizon REST API endpoint.
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"

# STELLAR_SOROBAN_RPC_URL: Official Stellar Soroban RPC endpoint for smart contracts.
STELLAR_SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"

# STELLAR_USDC_ASSET_CODE: Official Circle USDC asset code on Stellar.
STELLAR_USDC_ASSET_CODE="USDC"

# STELLAR_USDC_ISSUER_TESTNET: Official Circle Stellar Testnet USDC Issuer Public Key.
# Verified from official Circle / Stellar documentation:
# GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
STELLAR_USDC_ISSUER_TESTNET="GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5"

# STELLAR_USDC_ISSUER_MAINNET: Official Circle Stellar Mainnet USDC Issuer Public Key.
# GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
STELLAR_USDC_ISSUER_MAINNET="GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN"

# STELLAR_CUSTODY_MASTER_KEY: Server-only 256-bit key used by the backend signing service
# to encrypt managed wallet keys using AES-256-GCM. NEVER expose with VITE_ prefix.
STELLAR_CUSTODY_MASTER_KEY="REPLACE_WITH_32_BYTE_HEX_SERVER_CUSTODY_KEY"

# STELLAR_SPONSOR_RESERVE_SECRET: Optional server-side Stellar account secret used to sponsor
# base reserves for new farmer/worker accounts when Friendbot is not used.
STELLAR_SPONSOR_RESERVE_SECRET=""

# SOROBAN_SUPPORT_ESCROW_CONTRACT_ID: Deployed Soroban contract ID for 30% Sponsor-Farmer Support Escrow.
SOROBAN_SUPPORT_ESCROW_CONTRACT_ID="CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC"

# SOROBAN_WORKER_ESCROW_CONTRACT_ID: Deployed Soroban contract ID for isolated Farmer-Worker Wage Escrow.
SOROBAN_WORKER_ESCROW_CONTRACT_ID="CB64D3G7SM2RTH6JSGG34DDTFTQ5CFDKVDZJZSODMCX4NJ2HV2KN7OHT"

# NGN_ONRAMP_PROVIDER_ENABLED: Set to "true" ONLY after a licensed Nigerian SEP-24 / NGN on-off ramp
# provider (with KYC/AML and CBN compliance) is configured. Defaults to "false".
NGN_ONRAMP_PROVIDER_ENABLED="false"
NGN_ONRAMP_PROVIDER_NAME=""
NGN_ONRAMP_API_KEY=""

# FARMFUND_DEV_INITIAL_PASSWORD: Server-only temporary password for initial development accounts
# (FAMAD01, FAMER01, SPON01, COMP01). Subject to mandatory first-login password change.
FARMFUND_DEV_INITIAL_PASSWORD="ChangeMeFirstLogin!2026"
