        "status": { "type": "string", "enum": ["Open", "Under Mediation", "Resolved"], "maxLength": 40 },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "category", "referenceId", "raisedById", "status", "createdAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable admin compliance and verification action log.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "maxLength": 120 },
        "targetId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "actorId", "action", "targetId", "createdAt"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Platform-wide configuration editable only by Administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "platformName": { "type": "string", "maxLength": 80 },
        "activeNetwork": { "type": "string", "enum": ["TESTNET", "PUBLIC"], "maxLength": 20 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "platformName", "activeNetwork", "updatedAt"]
    },
    "UserWallet": {
      "title": "UserWallet",
      "description": "Public Stellar wallet record mapped to an authenticated FarmFund user (no private keys stored).",
      "type": "object",
      "properties": {
        "walletId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["Worker", "Farmer", "Supervisor", "Sponsor", "Admin"], "maxLength": 30 },
        "walletAddress": { "type": "string", "maxLength": 64, "pattern": "^G[A-Z2-7]{55}$" },
        "network": { "type": "string", "enum": ["TESTNET", "PUBLIC"], "maxLength": 20 },
        "status": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["walletId", "userId", "role", "walletAddress", "network", "status", "createdAt"]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "Stellar blockchain transaction record verified by Horizon backend.",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "walletId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "transactionHash": { "type": "string", "maxLength": 128 },
        "assetCode": { "type": "string", "enum": ["USDC", "XLM"], "maxLength": 16 },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending Verification", "Verified", "Failed", "Rejected"], "maxLength": 40 },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["transactionId", "userId", "walletId", "transactionHash", "assetCode", "amount", "status", "createdAt"]
    },
    "SupportFundingAgreementRecord": {
      "title": "SupportFundingAgreementRecord",
      "description": "Soroban escrow record for Sponsor-to-Farmer support funding.",
      "type": "object",
      "properties": {
        "agreementId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "farmerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sponsorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "agreedSharePercentage": { "type": "number" },
        "status": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["agreementId", "farmerId", "sponsorId", "agreedSharePercentage", "status", "createdAt"]
    },
    "WorkerPaymentAgreementRecord": {
      "title": "WorkerPaymentAgreementRecord",
      "description": "Isolated Soroban escrow for direct worker wages (0% sponsor deduction).",
      "type": "object",
      "properties": {
        "agreementId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "farmerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "paymentStatus": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["agreementId", "farmerId", "workerId", "paymentStatus", "createdAt"]
    },
    "WalletActivationRecord": {
      "title": "WalletActivationRecord",
      "description": "Stellar account activation and USDC trustline initialization record.",
      "type": "object",
      "properties": {
        "activationId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "walletId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["activationId", "userId", "walletId", "status", "createdAt"]
    },
    "WalletAuditLog": {
      "title": "WalletAuditLog",
      "description": "Immutable security audit log for Stellar wallet operations.",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "maxLength": 120 },
        "timestamp": { "type": "string", "maxLength": 60 }
      },
      "required": ["logId", "actorId", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/PlatformUser" }, "description": "Core FarmFund user records and role locks." },
