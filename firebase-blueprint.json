    "WalletAuditLog": {
      "title": "WalletAuditLog",
      "description": "Immutable security audit log for sensitive wallet, signing, and escrow actions.",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "maxLength": 120 },
        "targetUserId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "walletId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "transactionReference": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 60 },
        "result": { "type": "string", "maxLength": 120 }
      },
      "required": [
        "logId",
        "actorId",
        "action",
        "targetUserId",
        "walletId",
        "transactionReference",
        "timestamp",
        "result"
      ]
    }
  },
  "firestore": {
