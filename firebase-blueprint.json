    "DisputeRecord": {
      "title": "DisputeRecord",
      "description": "A dispute record logged for admin review on either a Sponsor Support Agreement or a Worker Payment.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
