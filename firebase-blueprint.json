    "UserWallet": {
      "title": "UserWallet",
      "description": "Public Stellar wallet record mapped to an authenticated FarmFund user or organisation (never contains secret keys).",
      "type": "object",
      "properties": {
        "walletId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["Farmer", "Worker", "Sponsor", "Company", "Admin"], "maxLength": 30 },
        "walletAddress": { "type": "string", "maxLength": 64, "pattern": "^G[A-Z2-7]{55}$" },
        "provider": { "type": "string", "maxLength": 120 },
        "custodyModel": { "type": "string", "maxLength": 120 },
        "network": { "type": "string", "enum": ["TESTNET", "PUBLIC"], "maxLength": 20 },
