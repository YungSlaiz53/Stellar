    "/supportUpdates/{updateId}": { "schema": { "$ref": "#/entities/SupportUpdate" }, "description": "Field updates attached to support agreements." },
    "/reviews/{reviewId}": { "schema": { "$ref": "#/entities/ReviewRecord" }, "description": "Completed agreement reviews." },
    "/disputes/{disputeId}": { "schema": { "$ref": "#/entities/DisputeRecord" }, "description": "Mediation disputes reviewed by Admin." },
    "/adminAuditLogs/{logId}": { "schema": { "$ref": "#/entities/AdminAuditLog" }, "description": "Admin verification and oversight audit logs." },
    "/platformSettings/{settingId}": { "schema": { "$ref": "#/entities/PlatformSettings" }, "description": "Platform global settings." },
