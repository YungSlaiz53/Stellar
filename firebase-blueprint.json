    "/sponsorFundingAgreements/{agreementId}": { "schema": { "$ref": "#/entities/SponsorFundingAgreement" }, "description": "Mutual agreements between Farmers and Sponsors." },
    "/workerRequests/{requestId}": { "schema": { "$ref": "#/entities/WorkerRequest" }, "description": "Farm worker jobs posted by Farmers or Sponsors." },
    "/workerApplications/{applicationId}": { "schema": { "$ref": "#/entities/WorkerApplication" }, "description": "Applications by Workers to farm jobs." },
