    "/farmerProfiles/{farmerId}": { "schema": { "$ref": "#/entities/FarmerProfile" }, "description": "Registered farmer profiles." },
    "/supervisorProfiles/{supervisorId}": { "schema": { "$ref": "#/entities/SupervisorProfile" }, "description": "Registered project supervisor profiles." },
    "/sponsorProfiles/{sponsorId}": { "schema": { "$ref": "#/entities/SponsorProfile" }, "description": "Registered individual and organisation sponsor profiles." },
    "/organisations/{organisationId}": { "schema": { "$ref": "#/entities/OrganisationProfile" }, "description": "Organisation sponsor entity profiles." },
