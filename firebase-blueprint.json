        "status": { "type": "string", "enum": ["Active", "Suspended"], "maxLength": 30 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "uid", "role", "fullName", "email", "verificationStatus", "status", "createdAt", "updatedAt"]
    },
