        "workersHired": { "type": "number" },
        "requiredSkills": { "type": "string", "maxLength": 1000 },
        "startDate": { "type": "string", "maxLength": 40 },
        "expectedDuration": { "type": "string", "maxLength": 100 },
        "workingHours": { "type": "string", "maxLength": 120 },
        "paymentAmountNaira": { "type": "number" },
        "paymentBasis": { "type": "string", "enum": ["Per Worker (Total Task)", "Per Worker (Daily)", "Agreed Total Team Payment"], "maxLength": 60 },
        "paymentMethod": { "type": "string", "maxLength": 100 },
        "accommodationOrFeeding": { "type": "string", "maxLength": 500 },
        "contactInstructions": { "type": "string", "maxLength": 500 },
        "photographs": { "type": "array" },
        "acknowledgedWageRule": { "type": "boolean" },
        "status": { "type": "string", "enum": ["Open", "Hiring in Progress", "In Progress", "Completed"], "maxLength": 40 },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": [
        "id",
        "farmerId",
        "farmerName",
        "farmName",
        "jobTitle",
        "workCategory",
        "description",
        "location",
        "workersNeeded",
        "requiredSkills",
        "startDate",
        "expectedDuration",
        "workingHours",
        "paymentAmountNaira",
        "paymentBasis",
        "paymentMethod",
        "acknowledgedWageRule",
        "status",
        "createdAt"
      ]
    },
