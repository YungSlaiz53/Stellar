{
  "entities": {
    "SupportRequest": {
      "title": "SupportRequest",
      "description": "A farmer's request for financial support, agricultural materials, or equipment under the 30% sponsor share model.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "farmerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "farmerName": { "type": "string", "maxLength": 120 },
        "title": { "type": "string", "maxLength": 200 },
        "farmName": { "type": "string", "maxLength": 150 },
        "farmingType": { "type": "string", "maxLength": 100 },
        "cropOrProduceType": { "type": "string", "maxLength": 120 },
        "location": { "type": "string", "maxLength": 150 },
        "farmSize": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 2000 },
        "assistanceType": { "type": "string", "enum": ["Financial Support", "Agricultural Materials", "Equipment", "Combined Support"], "maxLength": 60 },
        "fundingAmount": { "type": "number" },
        "materialsOrEquipment": { "type": "string", "maxLength": 1000 },
        "farmingPeriod": { "type": "string", "maxLength": 100 },
        "expectedHarvestDate": { "type": "string", "maxLength": 40 },
        "estimatedOutput": { "type": "string", "maxLength": 200 },
        "preferredShareModel": { "type": "string", "enum": ["30% Farm Produce Share", "30% Farm Funds Share"], "maxLength": 60 },
        "acknowledgedThirtyPercentNotice": { "type": "boolean" },
        "photographs": { "type": "array" },
        "supportingDocuments": { "type": "array" },
        "status": { "type": "string", "enum": ["Open", "Under Review", "Agreement Pending", "Active Support", "Completed"], "maxLength": 40 },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": [
        "id",
        "farmerId",
        "farmerName",
        "title",
        "farmName",
        "farmingType",
        "cropOrProduceType",
        "location",
        "farmSize",
        "description",
        "assistanceType",
        "farmingPeriod",
        "expectedHarvestDate",
        "estimatedOutput",
        "preferredShareModel",
        "acknowledgedThirtyPercentNotice",
        "status",
        "createdAt"
      ]
    },
    "SponsorFundingAgreement": {
      "title": "SponsorFundingAgreement",
      "description": "A formal 30% produce or farm-funds share agreement between a farmer and a sponsor.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requestId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requestTitle": { "type": "string", "maxLength": 200 },
        "farmerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "farmerName": { "type": "string", "maxLength": 120 },
        "sponsorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sponsorName": { "type": "string", "maxLength": 120 },
        "sponsorContribution": { "type": "string", "maxLength": 500 },
        "contributionValueNaira": { "type": "number" },
        "sharePercentage": { "type": "number" },
        "shareType": { "type": "string", "enum": ["30% Farm Produce Share", "30% Farm Funds Share"], "maxLength": 60 },
        "calculationMethod": { "type": "string", "maxLength": 1000 },
        "entitlementTiming": { "type": "string", "maxLength": 500 },
        "measurementVerification": { "type": "string", "maxLength": 1000 },
        "lossOrPoorHarvestClause": { "type": "string", "maxLength": 1000 },
        "additionalConditions": { "type": "string", "maxLength": 1000 },
        "farmerAccepted": { "type": "boolean" },
        "farmerAcceptedAt": { "type": "string", "maxLength": 60 },
        "sponsorAccepted": { "type": "boolean" },
        "sponsorAcceptedAt": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "enum": ["Pending Acceptance", "Active Agreement", "Completed", "Disputed"], "maxLength": 40 },
        "historyLog": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": [
        "id",
        "requestId",
        "requestTitle",
        "farmerId",
        "farmerName",
        "sponsorId",
        "sponsorName",
        "sponsorContribution",
        "contributionValueNaira",
        "sharePercentage",
        "shareType",
        "calculationMethod",
        "entitlementTiming",
        "measurementVerification",
        "lossOrPoorHarvestClause",
        "farmerAccepted",
        "sponsorAccepted",
        "status",
        "createdAt"
      ]
    },
    "WorkerProfile": {
      "title": "WorkerProfile",
      "description": "A farm worker's profile, skills, experience, expected wage, and verification status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "maxLength": 120 },
        "profilePicture": { "type": "string", "maxLength": 500 },
        "location": { "type": "string", "maxLength": 150 },
        "skills": { "type": "array" },
        "farmingExperience": { "type": "string", "maxLength": 1000 },
        "availableWorkTypes": { "type": "array" },
        "availability": { "type": "string", "maxLength": 120 },
        "expectedWageNaira": { "type": "number" },
        "wageUnit": { "type": "string", "maxLength": 60 },
        "contactPhone": { "type": "string", "maxLength": 60 },
        "contactVisibility": { "type": "string", "enum": ["Accepted Farmers Only", "Verified Farmers", "Hidden Until Offer"], "maxLength": 60 },
        "verificationStatus": { "type": "string", "enum": ["Verified", "Pending Verification", "Unverified"], "maxLength": 40 },
        "completedJobsCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": [
        "id",
        "userId",
        "fullName",
        "location",
        "farmingExperience",
        "availability",
        "expectedWageNaira",
        "wageUnit",
        "contactVisibility",
        "verificationStatus",
        "createdAt"
      ]
    },
    "WorkerRequest": {
      "title": "WorkerRequest",
      "description": "A labour-service request seeking farm workers for agreed wages (0% sponsor share).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "farmerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "farmerName": { "type": "string", "maxLength": 120 },
        "farmName": { "type": "string", "maxLength": 150 },
        "jobTitle": { "type": "string", "maxLength": 200 },
        "workCategory": { "type": "string", "maxLength": 120 },
        "customWorkCategory": { "type": "string", "maxLength": 200 },
