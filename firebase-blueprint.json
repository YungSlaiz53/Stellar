      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["Worker", "Farmer", "Supervisor", "Sponsor", "Admin"], "maxLength": 30 },
        "sponsorType": { "type": "string", "enum": ["individual", "organisation"], "maxLength": 30 },
        "fullName": { "type": "string", "maxLength": 140 },
        "email": { "type": "string", "maxLength": 180 },
        "phone": { "type": "string", "maxLength": 60 },
        "country": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "lga": { "type": "string", "maxLength": 100 },
        "townOrLocation": { "type": "string", "maxLength": 150 },
        "profilePicture": { "type": "string", "maxLength": 500 },
        "governmentIdDocument": { "type": "string", "maxLength": 500 },
