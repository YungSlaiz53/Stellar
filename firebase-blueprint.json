    "/workerPaymentAgreements/{agreementId}": { "schema": { "$ref": "#/entities/WorkerPaymentAgreementRecord" }, "description": "Isolated Soroban worker wage payment escrow records." },
    "/walletActivationRecords/{activationId}": { "schema": { "$ref": "#/entities/WalletActivationRecord" }, "description": "Stellar account activation records." },
