        isValidFarmerProfile(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (existing().userId == request.auth.uid &&
           (incoming().verificationStatus == existing().verificationStatus || incoming().verificationStatus == 'Pending Verification') &&
           incoming().diff(existing()).affectedKeys().hasOnly([
             'fullName', 'phone', 'country', 'state', 'lga', 'townOrFarmLocation',
             'profilePicture', 'governmentIdDocument', 'farmName', 'farmLocation',
             'farmingType', 'cropsOrLivestock', 'farmSize', 'yearsOfExperience',
             'farmDescription', 'agriculturalSupportNeeded', 'farmPhotographs',
