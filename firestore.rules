        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (existing().userId == request.auth.uid &&
           (incoming().verificationStatus == existing().verificationStatus || incoming().verificationStatus == 'Pending Verification') &&
           incoming().diff(existing()).affectedKeys().hasOnly([
             'fullName', 'phone', 'country', 'state', 'lga', 'residentialLocation',
             'profilePicture', 'governmentIdDocument', 'professionalQualifications',
             'agriculturalExperience', 'specialisations', 'previousSupervisionExperience',
