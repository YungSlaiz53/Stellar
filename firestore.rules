        isValidWorkerProfile(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (existing().userId == request.auth.uid &&
           (incoming().verificationStatus == existing().verificationStatus || incoming().verificationStatus == 'Pending Verification') &&
           incoming().diff(existing()).affectedKeys().hasOnly([
             'fullName', 'phone', 'country', 'state', 'lga', 'townOrCity',
             'residentialLocation', 'location', 'profilePicture', 'governmentIdDocument',
             'skills', 'farmingExperience', 'availableWorkTypes', 'availability',
             'expectedWageNaira', 'wageUnit', 'bio', 'supportingDocuments',
