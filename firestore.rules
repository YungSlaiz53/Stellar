           incoming().diff(existing()).affectedKeys().hasOnly([
             'organisationName', 'officialEmail', 'phone', 'officeAddress', 'country',
             'location', 'logoUrl', 'website', 'organisationType', 'representativeName',
             'representativePosition', 'representativeIdDocument', 'registrationDocuments',
             'description', 'agriculturalSupportCategories', 'supportTypesAvailable',
             'verificationStatus', 'updatedAt'
           ]))
