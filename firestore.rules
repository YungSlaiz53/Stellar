rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidStellarPublicKey(addr) {
      return addr is string && addr.size() == 56 && addr.matches('^G[A-Z2-7]{55}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'blessedogle52@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function userHasRole(roleName) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == roleName;
    }

    // Validation Blueprints
    function isValidPlatformUser(data) {
      return data.keys().hasAll([
        'id', 'uid', 'role', 'fullName', 'email', 'verificationStatus', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'uid', 'role', 'sponsorType', 'fullName', 'email', 'phone', 'country',
        'state', 'lga', 'townOrLocation', 'profilePicture', 'governmentIdDocument',
        'verificationStatus', 'verificationNotes', 'status', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.uid) &&
      data.role is string && data.role.size() <= 30 &&
      data.role in ['Worker', 'Farmer', 'Supervisor', 'Sponsor', 'Admin'] &&
      data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 140 &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 180 &&
      data.verificationStatus is string && data.verificationStatus.size() <= 40 &&
      data.verificationStatus in ['Pending Verification', 'Verified', 'Rejected', 'More Information Required'] &&
      data.status is string && data.status.size() <= 30 &&
      data.status in ['Active', 'Suspended'] &&
      data.createdAt is string && data.createdAt.size() <= 60 &&
      data.updatedAt is string && data.updatedAt.size() <= 60;
    }

    function isValidWorkerProfile(data) {
      return data.keys().hasAll([
        'id', 'userId', 'fullName', 'location', 'skills', 'farmingExperience',
        'availableWorkTypes', 'availability', 'expectedWageNaira', 'wageUnit',
        'verificationStatus', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'userId', 'fullName', 'email', 'phone', 'country', 'state', 'lga',
        'townOrCity', 'residentialLocation', 'location', 'profilePicture',
        'governmentIdDocument', 'skills', 'farmingExperience', 'availableWorkTypes',
        'availability', 'expectedWageNaira', 'wageUnit', 'bio', 'supportingDocuments',
        'contactVisibility', 'verificationStatus', 'completedJobsCount', 'status',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.userId) &&
      data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 140 &&
      data.location is string && data.location.size() >= 2 && data.location.size() <= 150 &&
      data.skills is list && data.skills.size() <= 20 &&
      (data.skills.size() == 0 || (data.skills[0] is string && data.skills[0].size() <= 80)) &&
      data.farmingExperience is string && data.farmingExperience.size() >= 2 && data.farmingExperience.size() <= 1000 &&
      data.availableWorkTypes is list && data.availableWorkTypes.size() <= 20 &&
      (data.availableWorkTypes.size() == 0 || (data.availableWorkTypes[0] is string && data.availableWorkTypes[0].size() <= 80)) &&
      data.availability is string && data.availability.size() >= 2 && data.availability.size() <= 120 &&
      data.expectedWageNaira is number && data.expectedWageNaira >= 0 && data.expectedWageNaira <= 10000000 &&
      data.wageUnit is string && data.wageUnit.size() >= 2 && data.wageUnit.size() <= 60 &&
      data.verificationStatus is string && data.verificationStatus.size() <= 40 &&
      data.verificationStatus in ['Pending Verification', 'Verified', 'Rejected', 'More Information Required'] &&
      data.createdAt is string && data.createdAt.size() <= 60 &&
      data.updatedAt is string && data.updatedAt.size() <= 60;
    }

    function isValidFarmerProfile(data) {
      return data.keys().hasAll([
        'id', 'userId', 'fullName', 'farmName', 'farmLocation', 'verificationStatus', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'userId', 'fullName', 'email', 'phone', 'country', 'state', 'lga',
        'townOrFarmLocation', 'profilePicture', 'governmentIdDocument', 'farmName',
        'farmLocation', 'farmingType', 'cropsOrLivestock', 'farmSize', 'yearsOfExperience',
        'farmDescription', 'agriculturalSupportNeeded', 'farmPhotographs',
        'supportingDocuments', 'verificationStatus', 'status', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.userId) &&
      data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 140 &&
      data.farmName is string && data.farmName.size() >= 2 && data.farmName.size() <= 150 &&
      data.farmLocation is string && data.farmLocation.size() >= 2 && data.farmLocation.size() <= 150 &&
      data.verificationStatus is string && data.verificationStatus.size() <= 40 &&
      data.verificationStatus in ['Pending Verification', 'Verified', 'Rejected', 'More Information Required'] &&
      data.createdAt is string && data.createdAt.size() <= 60 &&
      data.updatedAt is string && data.updatedAt.size() <= 60;
    }

    function isValidSupervisorProfile(data) {
      return data.keys().hasAll([
        'id', 'userId', 'fullName', 'professionalQualifications', 'verificationStatus', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'userId', 'fullName', 'email', 'phone', 'country', 'state', 'lga',
        'residentialLocation', 'profilePicture', 'governmentIdDocument',
        'professionalQualifications', 'agriculturalExperience', 'specialisations',
        'previousSupervisionExperience', 'certifications', 'bio',
        'availabilityAndServiceLocations', 'verificationStatus', 'status',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.userId) &&
      data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 140 &&
      data.professionalQualifications is string && data.professionalQualifications.size() >= 2 && data.professionalQualifications.size() <= 500 &&
      data.verificationStatus is string && data.verificationStatus.size() <= 40 &&
      data.verificationStatus in ['Pending Verification', 'Verified', 'Rejected', 'More Information Required'] &&
      data.createdAt is string && data.createdAt.size() <= 60 &&
      data.updatedAt is string && data.updatedAt.size() <= 60;
    }

    function isValidSponsorProfile(data) {
      return data.keys().hasAll([
        'id', 'userId', 'sponsorType', 'fullName', 'verificationStatus', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'userId', 'sponsorType', 'fullName', 'email', 'phone', 'country',
        'location', 'profilePicture', 'governmentIdDocument', 'description',
        'agriculturalInterests', 'supportTypesProvided', 'socialMediaLinks',
        'organisationId', 'verificationStatus', 'status', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.userId) &&
      data.sponsorType is string && data.sponsorType.size() <= 30 &&
      data.sponsorType in ['individual', 'organisation'] &&
      data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 140 &&
      data.verificationStatus is string && data.verificationStatus.size() <= 40 &&
      data.verificationStatus in ['Pending Verification', 'Verified', 'Rejected', 'More Information Required'] &&
      data.createdAt is string && data.createdAt.size() <= 60 &&
      data.updatedAt is string && data.updatedAt.size() <= 60;
    }

    function isValidOrganisationProfile(data) {
      return data.keys().hasAll([
        'id', 'userId', 'organisationName', 'officialEmail', 'representativeName',
        'verificationStatus', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'userId', 'organisationName', 'officialEmail', 'phone', 'officeAddress',
        'country', 'location', 'logoUrl', 'website', 'organisationType',
        'representativeName', 'representativePosition', 'representativeIdDocument',
        'registrationDocuments', 'description', 'agriculturalSupportCategories',
        'supportTypesAvailable', 'verificationStatus', 'status', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.userId) &&
      data.organisationName is string && data.organisationName.size() >= 2 && data.organisationName.size() <= 160 &&
      data.officialEmail is string && data.officialEmail.size() >= 3 && data.officialEmail.size() <= 180 &&
      data.representativeName is string && data.representativeName.size() >= 2 && data.representativeName.size() <= 120 &&
      data.verificationStatus is string && data.verificationStatus.size() <= 40 &&
      data.verificationStatus in ['Pending Verification', 'Verified', 'Rejected', 'More Information Required'] &&
      data.createdAt is string && data.createdAt.size() <= 60 &&
      data.updatedAt is string && data.updatedAt.size() <= 60;
    }

    function isValidSupportRequest(data) {
      return data.keys().hasAll([
        'id', 'farmerId', 'farmerName', 'title', 'farmName', 'location',
        'assistanceType', 'preferredShareModel', 'status', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'ownerId', 'farmerId', 'farmerName', 'targetSponsorId', 'targetSponsorName',
        'title', 'farmName', 'farmingType', 'cropOrProduceType', 'location', 'farmSize',
        'description', 'assistanceType', 'fundingAmount', 'materialsOrEquipment',
        'farmingPeriod', 'expectedHarvestDate', 'estimatedOutput', 'preferredShareModel',
        'explicitlyAgreedThirtyPercent', 'acknowledgedThirtyPercentNotice',
        'photographs', 'supportingDocuments', 'sponsorReviewNote', 'status', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.farmerId) &&
      data.farmerName is string && data.farmerName.size() >= 1 && data.farmerName.size() <= 140 &&
      data.title is string && data.title.size() >= 3 && data.title.size() <= 200 &&
      data.farmName is string && data.farmName.size() >= 2 && data.farmName.size() <= 150 &&
      data.location is string && data.location.size() >= 2 && data.location.size() <= 150 &&
      data.assistanceType is string && data.assistanceType.size() <= 80 &&
      data.preferredShareModel is string && data.preferredShareModel.size() <= 60 &&
      data.preferredShareModel in ['None (Standard Support)', '30% Farm Produce Share', '30% Farm Funds Share'] &&
      data.status is string && data.status.size() <= 50 &&
      data.status in ['Open', 'Under Review', 'More Information Requested', 'Agreement Pending', 'Active Support', 'Declined', 'Completed'] &&
      data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidSponsorOffer(data) {
      return data.keys().hasAll([
        'id', 'sponsorId', 'farmerId', 'title', 'shareType', 'status', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'ownerId', 'sponsorId', 'sponsorName', 'sponsorType', 'farmerId', 'farmerName',
        'title', 'supportCategory', 'fundingOrMaterialContribution', 'contributionValueNaira',
        'proposedConditions', 'usesThirtyPercentShare', 'shareType', 'supervisionRecommended',
        'status', 'farmerResponseNote', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.sponsorId) &&
      isValidId(data.farmerId) &&
      data.title is string && data.title.size() >= 2 && data.title.size() <= 200 &&
      data.shareType is string && data.shareType.size() <= 60 &&
      data.shareType in ['None (Standard Support)', '30% Farm Produce Share', '30% Farm Funds Share'] &&
      data.status is string && data.status.size() <= 50 &&
      data.status in ['Sent', 'Accepted by Farmer', 'Declined by Farmer', 'More Information Requested'] &&
      data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidSponsorFundingAgreement(data) {
      return data.keys().hasAll([
        'id', 'requestId', 'farmerId', 'sponsorId', 'sharePercentage', 'shareType',
        'farmerAccepted', 'sponsorAccepted', 'status', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'ownerId', 'requestId', 'offerId', 'requestTitle', 'farmerId', 'farmerName',
        'sponsorId', 'sponsorName', 'location', 'sponsorContribution', 'contributionValueNaira',
        'usesThirtyPercentShare', 'sharePercentage', 'shareType', 'calculationMethod',
        'entitlementTiming', 'measurementVerification', 'lossOrPoorHarvestClause',
        'additionalConditions', 'expectedStartDate', 'expectedCompletionDate',
        'supervisionRequired', 'assignedSupervisorId', 'assignedSupervisorName',
        'farmerAccepted', 'farmerAcceptedAt', 'sponsorAccepted', 'sponsorAcceptedAt',
        'status', 'historyLog', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.requestId) &&
      isValidId(data.farmerId) &&
      isValidId(data.sponsorId) &&
      data.sharePercentage is number && (data.sharePercentage == 0 || data.sharePercentage == 30) &&
      data.shareType is string && data.shareType.size() <= 60 &&
      data.shareType in ['None (Standard Support)', '30% Farm Produce Share', '30% Farm Funds Share'] &&
      data.farmerAccepted is bool &&
      data.sponsorAccepted is bool &&
      data.status is string && data.status.size() <= 50 &&
      data.status in ['Pending Acceptance', 'Active Agreement', 'Completion Recommended', 'Completed', 'Disputed'] &&
      data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidWorkerRequest(data) {
      return data.keys().hasAll([
        'id', 'hirerId', 'hirerRole', 'farmerId', 'jobTitle', 'workCategory',
        'location', 'workersNeeded', 'paymentAmountNaira', 'acknowledgedWageRule', 'status', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'ownerId', 'hirerId', 'hirerRole', 'hirerName', 'farmerId', 'farmerName',
        'farmName', 'jobTitle', 'workCategory', 'customWorkCategory', 'description',
        'location', 'workersNeeded', 'workersHired', 'requiredSkills', 'startDate',
        'expectedDuration', 'workingHours', 'paymentAmountNaira', 'paymentBasis',
        'paymentMethod', 'accommodationOrFeeding', 'contactInstructions', 'photographs',
        'acknowledgedWageRule', 'supervisionRequired', 'status', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.hirerId) &&
      data.hirerRole is string && data.hirerRole.size() <= 20 &&
      data.hirerRole in ['Farmer', 'Sponsor'] &&
      isValidId(data.farmerId) &&
      data.jobTitle is string && data.jobTitle.size() >= 3 && data.jobTitle.size() <= 200 &&
      data.workCategory is string && data.workCategory.size() >= 2 && data.workCategory.size() <= 120 &&
      data.location is string && data.location.size() >= 2 && data.location.size() <= 150 &&
      data.workersNeeded is number && data.workersNeeded >= 1 && data.workersNeeded <= 500 &&
      data.paymentAmountNaira is number && data.paymentAmountNaira > 0 && data.paymentAmountNaira <= 100000000 &&
      data.acknowledgedWageRule is bool && data.acknowledgedWageRule == true &&
      data.status is string && data.status.size() <= 40 &&
      data.status in ['Open', 'Hiring in Progress', 'In Progress', 'Completed', 'Closed'] &&
      data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidWorkerApplication(data) {
      return data.keys().hasAll([
        'id', 'workerRequestId', 'hirerId', 'farmerId', 'workerId', 'proposedWageNaira', 'status', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'ownerId', 'workerRequestId', 'jobTitle', 'workCategory', 'location',
        'hirerId', 'hirerRole', 'hirerName', 'farmerId', 'farmerName', 'workerId',
        'workerName', 'workerSkills', 'proposedWageNaira', 'message', 'status',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.workerRequestId) &&
      isValidId(data.hirerId) &&
      isValidId(data.farmerId) &&
      isValidId(data.workerId) &&
      data.proposedWageNaira is number && data.proposedWageNaira > 0 && data.proposedWageNaira <= 100000000 &&
      data.status is string && data.status.size() <= 40 &&
      data.status in ['Applied', 'Offered by Hirer', 'Accepted', 'Declined', 'Withdrawn', 'Work Completed'] &&
      data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidWorkerAgreement(data) {
      return data.keys().hasAll([
        'id', 'workerRequestId', 'hirerId', 'farmerId', 'workerId', 'agreedWageNaira',
        'workCompletedConfirmed', 'status', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'ownerId', 'workerRequestId', 'applicationId', 'jobTitle', 'hirerId',
        'hirerRole', 'hirerName', 'farmerId', 'farmerName', 'workerId', 'workerName',
        'location', 'agreedWageNaira', 'paymentBasis', 'paymentMethod', 'startDate',
        'expectedDuration', 'supervisionRequired', 'assignedSupervisorId',
        'assignedSupervisorName', 'workCompletedConfirmed', 'status', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.workerRequestId) &&
      isValidId(data.hirerId) &&
      isValidId(data.farmerId) &&
      isValidId(data.workerId) &&
      data.agreedWageNaira is number && data.agreedWageNaira > 0 && data.agreedWageNaira <= 100000000 &&
      data.workCompletedConfirmed is bool &&
      data.status is string && data.status.size() <= 40 &&
      data.status in ['Active Work', 'Completion Recommended', 'Work Completed', 'Declined'] &&
      data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidWorkerPayment(data) {
      return data.keys().hasAll([
        'id', 'workerAgreementId', 'farmerId', 'workerId', 'amountNaira',
        'sponsorShareDeducted', 'workConfirmedByFarmer', 'paymentConfirmedByWorker', 'status', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'workerAgreementId', 'workerRequestId', 'jobTitle', 'farmerId', 'farmerName',
        'hirerId', 'hirerName', 'workerId', 'workerName', 'amountNaira',
        'sponsorShareDeducted', 'paymentMethod', 'workConfirmedByFarmer',
        'paymentConfirmedByWorker', 'status', 'paidAt', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.workerAgreementId) &&
      isValidId(data.farmerId) &&
      isValidId(data.workerId) &&
      data.amountNaira is number && data.amountNaira > 0 && data.amountNaira <= 100000000 &&
      data.sponsorShareDeducted is number && data.sponsorShareDeducted == 0 &&
      data.workConfirmedByFarmer is bool &&
      data.paymentConfirmedByWorker is bool &&
      data.status is string && data.status.size() <= 40 &&
      data.status in ['Pending Work Completion', 'Awaiting Payment Confirmation', 'Confirmed Paid', 'Disputed'] &&
      (data.status != 'Confirmed Paid' || (data.workConfirmedByFarmer == true && data.paymentConfirmedByWorker == true)) &&
      data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidSupervisionRequest(data) {
      return data.keys().hasAll([
        'id', 'requestedById', 'agreementId', 'invitedSupervisorId', 'projectTitle', 'status', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'ownerId', 'requestedById', 'requestedByName', 'requestedByRole',
        'agreementId', 'agreementCategory', 'projectTitle', 'location',
        'farmerId', 'farmerName', 'sponsorId', 'sponsorName', 'workerId', 'workerName',
        'agreedWorkSummary', 'expectedStartDate', 'expectedCompletionDate',
        'supervisionInstructions', 'invitedSupervisorId', 'invitedSupervisorName',
        'status', 'responseNote', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.requestedById) &&
      isValidId(data.agreementId) &&
      isValidId(data.invitedSupervisorId) &&
      data.projectTitle is string && data.projectTitle.size() >= 2 && data.projectTitle.size() <= 200 &&
      data.status is string && data.status.size() <= 30 &&
      data.status in ['Invited', 'Accepted', 'Declined', 'Cancelled'] &&
      data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidSupervisionAssignment(data) {
      return data.keys().hasAll([
        'id', 'supervisionRequestId', 'agreementId', 'supervisorId', 'projectTitle', 'status', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'ownerId', 'supervisionRequestId', 'agreementId', 'agreementCategory',
        'projectTitle', 'location', 'supervisorId', 'supervisorName',
        'farmerId', 'farmerName', 'sponsorId', 'sponsorName', 'workerId', 'workerName',
        'agreedWorkSummary', 'expectedStartDate', 'expectedCompletionDate',
        'supervisionRequirements', 'status', 'completionRecommendedAt', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.supervisionRequestId) &&
      isValidId(data.agreementId) &&
      isValidId(data.supervisorId) &&
      data.projectTitle is string && data.projectTitle.size() >= 2 && data.projectTitle.size() <= 200 &&
      data.status is string && data.status.size() <= 40 &&
      data.status in ['Active Supervision', 'Completion Recommended', 'Completed'] &&
      data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidSupervisionReport(data) {
      return data.keys().hasAll([
        'id', 'assignmentId', 'supervisorId', 'reportType', 'summary', 'observations', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'ownerId', 'assignmentId', 'agreementId', 'supervisorId', 'supervisorName',
        'reportType', 'summary', 'observations', 'recommendCompletion',
        'evidenceUrls', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.assignmentId) &&
      isValidId(data.supervisorId) &&
      data.reportType is string && data.reportType.size() <= 80 &&
      data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 400 &&
      data.observations is string && data.observations.size() >= 2 && data.observations.size() <= 2000 &&
      data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['id', 'participantIds', 'contextTitle', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'participantIds', 'participantNames', 'participantRoles',
          'contextType', 'contextId', 'contextTitle', 'lastMessagePreview',
          'lastMessageAt', 'unreadByUser', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.participantIds is list && data.participantIds.size() >= 2 && data.participantIds.size() <= 5 &&
        data.contextTitle is string && data.contextTitle.size() >= 1 && data.contextTitle.size() <= 200 &&
        data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidDirectMessage(data) {
      return data.keys().hasAll(['id', 'senderId', 'senderRole', 'recipientId', 'body', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'conversationId', 'senderId', 'senderName', 'senderRole', 'recipientId',
          'recipientName', 'contextTitle', 'body', 'attachments', 'readBy',
          'replyToId', 'replyToPreview', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.senderId) &&
        data.senderRole is string && data.senderRole.size() <= 30 &&
        data.senderRole in ['Worker', 'Farmer', 'Supervisor', 'Sponsor', 'Admin'] &&
        isValidId(data.recipientId) &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 1500 &&
        data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidPlatformNotification(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'body', 'read', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'body', 'category', 'relatedId', 'read', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 500 &&
        data.read is bool &&
        data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidVerificationApplication(data) {
      return data.keys().hasAll(['id', 'userId', 'role', 'status', 'submittedAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'role', 'applicantName', 'applicantEmail',
          'governmentIdDocument', 'supportingDocuments', 'status',
          'reviewerId', 'reviewerName', 'reviewerNotes', 'submittedAt',
          'reviewedAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.role is string && data.role.size() <= 30 &&
        data.role in ['Worker', 'Farmer', 'Supervisor', 'Sponsor'] &&
        data.status is string && data.status.size() <= 40 &&
        data.status in ['Pending Verification', 'Verified', 'Rejected', 'More Information Required'] &&
        data.submittedAt is string && data.submittedAt.size() <= 60;
    }

    function isValidSupportUpdate(data) {
      return data.keys().hasAll(['id', 'agreementId', 'authorId', 'title', 'notes', 'createdAt']) &&
        data.keys().hasOnly(['id', 'agreementId', 'authorId', 'authorName', 'authorRole', 'title', 'notes', 'photoUrls', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.agreementId) &&
        isValidId(data.authorId) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 200 &&
        data.notes is string && data.notes.size() >= 2 && data.notes.size() <= 1500 &&
        data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidReviewRecord(data) {
      return data.keys().hasAll(['id', 'reviewerId', 'targetUserId', 'agreementId', 'rating', 'createdAt']) &&
        data.keys().hasOnly(['id', 'reviewerId', 'reviewerName', 'targetUserId', 'agreementId', 'rating', 'comment', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.reviewerId) &&
        isValidId(data.targetUserId) &&
        isValidId(data.agreementId) &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidDisputeRecord(data) {
      return data.keys().hasAll(['id', 'category', 'referenceId', 'raisedById', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'category', 'referenceId', 'title', 'raisedById', 'raisedByName',
          'summary', 'status', 'resolutionNotes', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.category is string && data.category.size() <= 60 &&
        isValidId(data.referenceId) &&
        isValidId(data.raisedById) &&
        data.status is string && data.status.size() <= 40 &&
        data.status in ['Open', 'Under Mediation', 'Resolved'] &&
        data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidAdminAuditLog(data) {
      return data.keys().hasAll(['id', 'actorId', 'action', 'targetId', 'createdAt']) &&
        data.keys().hasOnly(['id', 'actorId', 'actorName', 'actorRole', 'action', 'targetCollection', 'targetId', 'summary', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.actorId) &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 120 &&
        isValidId(data.targetId) &&
        data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidPlatformSettings(data) {
      return data.keys().hasAll(['id', 'platformName', 'activeNetwork', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'platformName', 'activeNetwork', 'requireEmailVerification',
          'defaultThirtyPercentNoticeEnabled', 'updatedBy', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.platformName is string && data.platformName.size() >= 2 && data.platformName.size() <= 80 &&
        data.activeNetwork is string && data.activeNetwork.size() <= 20 &&
        data.activeNetwork in ['TESTNET', 'PUBLIC'] &&
        data.updatedAt is string && data.updatedAt.size() <= 60;
    }

    function isValidUserWallet(data) {
      return data.keys().hasAll(['walletId', 'userId', 'role', 'walletAddress', 'network', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'walletId', 'userId', 'role', 'sponsorType', 'displayName', 'organisationName',
          'authorisedRepresentatives', 'approvalPolicy', 'walletAddress', 'provider',
          'custodyModel', 'network', 'status', 'usdcBalance', 'availableUsdcBalance',
          'pendingEscrowUsdcBalance', 'xlmBalance', 'hasUsdcTrustline', 'horizonReachable',
          'createdAt', 'updatedAt', 'lastVerifiedAt'
        ]) &&
        isValidId(data.walletId) &&
        isValidId(data.userId) &&
        data.role is string && data.role.size() <= 30 &&
        data.role in ['Worker', 'Farmer', 'Supervisor', 'Sponsor', 'Admin'] &&
        isValidStellarPublicKey(data.walletAddress) &&
        data.network is string && data.network.size() <= 20 &&
        data.network in ['TESTNET', 'PUBLIC'] &&
        data.status is string && data.status.size() <= 40 &&
        data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidWalletTransaction(data) {
      return data.keys().hasAll([
        'transactionId', 'userId', 'walletId', 'transactionHash', 'assetCode', 'amount', 'status', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'transactionId', 'userId', 'walletId', 'transactionHash', 'transactionType',
        'assetCode', 'assetIssuer', 'amount', 'senderAddress', 'recipientAddress',
        'memoReference', 'relatedRequestId', 'relatedAgreementId', 'relatedWorkerJobId',
        'status', 'explorerUrl', 'createdAt', 'verifiedAt'
      ]) &&
      isValidId(data.transactionId) &&
      isValidId(data.userId) &&
      isValidId(data.walletId) &&
      data.transactionHash is string && data.transactionHash.size() >= 8 && data.transactionHash.size() <= 128 &&
      data.assetCode is string && data.assetCode.size() <= 16 && data.assetCode in ['USDC', 'XLM'] &&
      data.amount is number && data.amount > 0 && data.amount <= 1000000000 &&
      data.status is string && data.status.size() <= 40 &&
      data.status in ['Pending Verification', 'Verified', 'Failed', 'Rejected'] &&
      data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidSupportFundingAgreementRecord(data) {
      return data.keys().hasAll([
        'agreementId', 'farmerId', 'sponsorId', 'agreedSharePercentage', 'status', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'agreementId', 'farmerId', 'farmerName', 'sponsorId', 'sponsorName', 'requestId',
        'requestTitle', 'contributionAmount', 'asset', 'shareType', 'agreedSharePercentage',
        'conditions', 'acceptanceRecords', 'escrowAddress', 'transactionHash', 'status',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.agreementId) &&
      isValidId(data.farmerId) &&
      isValidId(data.sponsorId) &&
      data.agreedSharePercentage is number && (data.agreedSharePercentage == 0 || data.agreedSharePercentage == 30) &&
      data.status is string && data.status.size() <= 40 &&
      data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidWorkerPaymentAgreementRecord(data) {
      return data.keys().hasAll(['agreementId', 'farmerId', 'workerId', 'paymentStatus', 'createdAt']) &&
        data.keys().hasOnly([
          'agreementId', 'farmerId', 'farmerName', 'workerId', 'workerName',
          'workerWalletAddress', 'workerRequestId', 'jobTitle', 'agreedWage',
          'paymentAsset', 'paymentAmount', 'conversionRateUsedNgnPerUsdc',
          'sponsorShareDeducted', 'workStatus', 'paymentStatus', 'transactionHash',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.agreementId) &&
        isValidId(data.farmerId) &&
        isValidId(data.workerId) &&
        data.paymentStatus is string && data.paymentStatus.size() <= 40 &&
        data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidWalletActivationRecord(data) {
      return data.keys().hasAll(['activationId', 'userId', 'walletId', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'activationId', 'userId', 'walletId', 'activationMethod',
          'transactionHash', 'status', 'createdAt', 'verifiedAt'
        ]) &&
        isValidId(data.activationId) &&
        isValidId(data.userId) &&
        isValidId(data.walletId) &&
        data.status is string && data.status.size() <= 40 &&
        data.createdAt is string && data.createdAt.size() <= 60;
    }

    function isValidWalletAuditLog(data) {
      return data.keys().hasAll(['logId', 'actorId', 'action', 'timestamp']) &&
        data.keys().hasOnly([
          'logId', 'actorId', 'action', 'targetUserId', 'walletId',
          'transactionReference', 'timestamp', 'result'
        ]) &&
        isValidId(data.logId) &&
        isValidId(data.actorId) &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 120 &&
        data.timestamp is string && data.timestamp.size() <= 60;
    }

    function isValidAcceptanceFee(data) {
      return data.keys().hasAll([
        'id', 'ownerId', 'obligorId', 'obligorRole', 'beneficiaryId',
        'agreementType', 'agreementId', 'feeAmountNaira', 'feeAmountUsdc',
        'assetCode', 'status', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'ownerId', 'obligorId', 'obligorName', 'obligorRole', 'beneficiaryId',
        'beneficiaryName', 'agreementType', 'agreementId', 'agreementTitle',
        'agreedPrincipalNaira', 'feeAmountNaira', 'feeAmountUsdc', 'assetCode',
        'status', 'escrowReference', 'transactionHash', 'settlementHash',
        'abscondedReason', 'reportedById', 'createdAt', 'updatedAt', 'resolvedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.ownerId) &&
      isValidId(data.obligorId) &&
      data.obligorRole is string && data.obligorRole in ['Worker', 'Farmer'] &&
      isValidId(data.beneficiaryId) &&
      data.agreementType is string && data.agreementType in ['WorkerHiring', 'SponsorSupport'] &&
      isValidId(data.agreementId) &&
      data.feeAmountNaira is number && data.feeAmountNaira >= 1000 && data.feeAmountNaira <= 100000 &&
      data.feeAmountUsdc is number && data.feeAmountUsdc > 0 && data.feeAmountUsdc <= 10000 &&
      data.assetCode is string && data.assetCode == 'USDC' &&
      data.status is string &&
      data.status in ['Pending Deposit', 'Locked in Escrow', 'Refunded', 'Forfeited (Absconded)', 'Disputed'] &&
      data.createdAt is string && data.createdAt.size() <= 60;
    }

    // Core Users (Strict PII Protection + Role Lock + No Public Admin Self-Assignment + No Self-Verification)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        existing().uid == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().uid == request.auth.uid || isAdmin()
      );
      allow create: if isVerifiedUser() && isValidId(userId) &&
        isValidPlatformUser(incoming()) &&
        incoming().id == userId &&
        incoming().uid == request.auth.uid &&
        incoming().role in ['Worker', 'Farmer', 'Supervisor', 'Sponsor'] &&
        incoming().verificationStatus == 'Pending Verification';
      allow update: if isVerifiedUser() && isValidId(userId) &&
        isValidPlatformUser(incoming()) &&
        incoming().id == existing().id &&
        incoming().uid == existing().uid &&
        incoming().role == existing().role &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (existing().uid == request.auth.uid &&
           (incoming().verificationStatus == existing().verificationStatus || incoming().verificationStatus == 'Pending Verification') &&
           incoming().diff(existing()).affectedKeys().hasOnly([
             'fullName', 'phone', 'country', 'state', 'lga', 'townOrLocation',
             'profilePicture', 'governmentIdDocument', 'verificationStatus', 'updatedAt'
           ]))
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Role Profiles
    match /workerProfiles/{workerId} {
      allow get: if isSignedIn() && isValidId(workerId) && (
