      allow delete: if isAdmin() && isValidId(organisationId);
    }

    // Farmer Assistance Requests (also supports /assistanceRequests alias)
    match /supportRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        existing().farmerId == request.auth.uid ||
        existing().status in ['Open', 'Under Review', 'More Information Requested', 'Agreement Pending', 'Active Support'] ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().farmerId == request.auth.uid ||
        existing().status in ['Open', 'Under Review', 'More Information Requested', 'Agreement Pending', 'Active Support'] ||
        isAdmin()
      );
      allow create: if isVerifiedUser() && isValidId(requestId) &&
        isValidSupportRequest(incoming()) &&
        incoming().id == requestId &&
        incoming().farmerId == request.auth.uid;
      allow update: if isVerifiedUser() && isValidId(requestId) &&
        isValidSupportRequest(incoming()) &&
        incoming().id == existing().id &&
        incoming().farmerId == existing().farmerId &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (existing().status != 'Completed' && existing().farmerId == request.auth.uid &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'description', 'fundingAmount', 'materialsOrEquipment', 'updatedAt'])) ||
          (existing().status in ['Open', 'More Information Requested'] &&
           incoming().status in ['Agreement Pending', 'More Information Requested', 'Declined'] &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'sponsorReviewNote', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(requestId);
    }

    match /assistanceRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        existing().farmerId == request.auth.uid ||
        existing().status in ['Open', 'Under Review', 'More Information Requested', 'Agreement Pending', 'Active Support'] ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().farmerId == request.auth.uid ||
        existing().status in ['Open', 'Under Review', 'More Information Requested', 'Agreement Pending', 'Active Support'] ||
        isAdmin()
      );
      allow create: if isVerifiedUser() && isValidId(requestId) &&
        isValidSupportRequest(incoming()) &&
        incoming().id == requestId &&
        incoming().farmerId == request.auth.uid;
      allow update: if isVerifiedUser() && isValidId(requestId) &&
        isValidSupportRequest(incoming()) &&
        incoming().id == existing().id &&
        incoming().farmerId == existing().farmerId &&
