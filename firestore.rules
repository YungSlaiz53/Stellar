           existing().obligorId == request.auth.uid &&
           incoming().status == 'Locked in Escrow' &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'transactionHash', 'updatedAt'])) ||
          ((existing().status == 'Locked in Escrow' || existing().status == 'Disputed') &&
           existing().beneficiaryId == request.auth.uid &&
           incoming().status in ['Refunded', 'Forfeited (Absconded)', 'Disputed'] &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'settlementHash', 'abscondedReason', 'reportedById', 'updatedAt', 'resolvedAt']))
        );
      allow delete: if false;
    }
  }
}
