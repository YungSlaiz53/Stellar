    match /supportAgreements/{agreementId} {
      allow get: if isSignedIn() && isValidId(agreementId) && (
        existing().farmerId == request.auth.uid ||
        existing().sponsorId == request.auth.uid ||
        existing().assignedSupervisorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().farmerId == request.auth.uid ||
        existing().sponsorId == request.auth.uid ||
        existing().assignedSupervisorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isVerifiedUser() && isValidId(agreementId) &&
        isValidSponsorFundingAgreement(incoming()) &&
        incoming().id == agreementId &&
        (incoming().farmerId == request.auth.uid || incoming().sponsorId == request.auth.uid);
      allow update: if isVerifiedUser() && isValidId(agreementId) &&
        isValidSponsorFundingAgreement(incoming()) &&
        incoming().id == existing().id &&
        incoming().farmerId == existing().farmerId &&
        incoming().sponsorId == existing().sponsorId &&
        incoming().sharePercentage == existing().sharePercentage &&
        incoming().shareType == existing().shareType &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (existing().status == 'Pending Acceptance' && existing().farmerId == request.auth.uid &&
           incoming().diff(existing()).affectedKeys().hasOnly(['farmerAccepted', 'farmerAcceptedAt', 'status', 'historyLog', 'updatedAt'])) ||
          (existing().status == 'Pending Acceptance' && existing().sponsorId == request.auth.uid &&
           incoming().diff(existing()).affectedKeys().hasOnly(['sponsorAccepted', 'sponsorAcceptedAt', 'status', 'historyLog', 'updatedAt'])) ||
          (existing().status == 'Active Agreement' && (existing().farmerId == request.auth.uid || existing().sponsorId == request.auth.uid) &&
           incoming().diff(existing()).affectedKeys().hasOnly(['supervisionRequired', 'assignedSupervisorId', 'assignedSupervisorName', 'historyLog', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(agreementId);
    }

    match /sponsorFundingAgreements/{agreementId} {
      allow get: if isSignedIn() && isValidId(agreementId) && (
        existing().farmerId == request.auth.uid ||
        existing().sponsorId == request.auth.uid ||
        existing().assignedSupervisorId == request.auth.uid ||
